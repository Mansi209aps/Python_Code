class Solution:
    def isPrime(self, n):
        limit = int (n ** 0.5)
        cnt = 0
        
        for i in range (1,limit+1):
            
            if n%i==0:
                cnt+=1

                if int(n/i) != i:
                    cnt+=1
                    
        if cnt == 2:
            return True
        return False
        
